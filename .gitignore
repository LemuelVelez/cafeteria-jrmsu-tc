/node_modules/
/vendor/
.env
.phpunit.result.cache
/writable/cache/*
/writable/debugbar/*
/writable/logs/*
/writable/session/*
/writable/uploads/*
/public/uploads/products/*
!/writable/cache/.gitkeep
!/writable/debugbar/.gitkeep
!/writable/logs/.gitkeep
!/writable/session/.gitkeep
!/writable/uploads/.gitkeep
!/public/uploads/products/.gitkeep

/public/uploads/avatars/*

/writable/backups/*
!/writable/backups/.gitkeep

# Local nutrition catalog import lockfiles; never source or commit these.
/app/Database/Seeds/data/*.csv.lock
/app/Database/Seeds/data/.populate.lock

# Keep the auto-generated application encryption key out of source control.
/writable/.encryption-key
