CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
app.defaultLocale = 'en'
app.negotiateLocale = false
# Production: set these to true and serve HTTPS only. Config defaults to true in production.
app.forceGlobalSecureRequests = false
app.cookieSecure = false
app.CSPEnabled = false
app.appTimezone = 'Asia/Manila'

encryption.key = 'replace-with-a-long-random-secret-key'

MySQL_Database_URL = 'MySQLi://jrmsu_user:change_me@127.0.0.1:3306/jrmsu_tc_cafeteria?charset=utf8mb4&DBCollat=utf8mb4_unicode_ci'

CAFETERIA_NAME = 'JRMSU-TC Cafeteria'
CAFETERIA_CURRENCY = 'PHP'
CAFETERIA_TIMEZONE = 'Asia/Manila'
CAFETERIA_DELIVERY_FEE = 40.00
CAFETERIA_ORDER_PREFIX = 'JRMSU'
CAFETERIA_IDLE_TIMEOUT = 1800
CAFETERIA_IDLE_TIMEOUT_ADMIN = 1800
CAFETERIA_IDLE_TIMEOUT_CASHIER = 1800
CAFETERIA_IDLE_TIMEOUT_RIDER = 1800
CAFETERIA_IDLE_TIMEOUT_CUSTOMER = 7200

AWS_REGION = ap-southeast-1
AWS_S3_BUCKET =
AWS_ACCESS_KEY_ID =
AWS_SECRET_ACCESS_KEY =

SESSION_COOKIE_NAME = 'jrmsu_tc_cafeteria_session'
UPLOAD_MAX_SIZE_MB = 5


GMAIL_USER=
GMAIL_APP_PASSWORD=

# Nutrition lookup uses server-side USDA FoodData Central (optional, never exposed to clients)
FDC_API_KEY = ''
# VAPID keys only if Web Push is explicitly configured
VAPID_PUBLIC_KEY = ''
VAPID_PRIVATE_KEY = ''
# Encrypted gzip backup / retention / optional AWS S3 offsite copy
BACKUP_KEEP_DAILY = 7
BACKUP_KEEP_WEEKLY = 4
BACKUP_KEEP_MONTHLY = 6
BACKUP_S3_BUCKET = ''
AWS_DEFAULT_REGION = 'ap-southeast-1'
# Attendance estimates: configurable premiums, not statutory payroll
ATTENDANCE_OVERTIME_PREMIUM = 0.25
ATTENDANCE_NIGHT_DIFFERENTIAL = 0.10
